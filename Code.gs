const SPREADSHEET_ID='1bYREWjxhhDjY2y9M3DZ20Mt-qY8iEO0hKUyoYOvrHJc';
const CACHE_SECONDS=300, DEFAULT_TZ='Asia/Bangkok';
function doGet(e){const a=String(e?.parameter?.action||'publicContent');if(a==='health')return json_({ok:true,time:new Date().toISOString()});if(a!=='publicContent')return json_({ok:false,error:'Unknown action'});const c=CacheService.getScriptCache(),k='site-data-v5',x=c.get(k);if(x)return json_(JSON.parse(x));const d=buildSiteData_();c.put(k,JSON.stringify(d),CACHE_SECONDS);return json_(d)}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
function rows_(n){const s=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(n);if(!s||s.getLastRow()<2)return[];const v=s.getDataRange().getDisplayValues(),h=v.shift().map(String);return v.filter(r=>r.some(x=>String(x).trim()!=='')).map(r=>Object.fromEntries(h.map((x,i)=>[x,r[i]])))}
const truthy_=v=>/^(true|1|yes|on)$/i.test(String(v||'').trim());const split_=v=>String(v||'').split('|').map(s=>s.trim()).filter(Boolean);
function dateOnly_(v){if(!v)return'';const d=new Date(v);return isNaN(d)?String(v).slice(0,10):Utilities.formatDate(d,'Etc/UTC','yyyy-MM-dd')}
function blocks_(rs,f,id){return rs.filter(r=>String(r[f])===String(id)).sort((a,b)=>Number(a.Sort||0)-Number(b.Sort||0)).map(r=>({type:String(r.Type||'paragraph').toLowerCase(),value:r.Value||'',alt:r.Alt||''}))}
function episodeStatus_(dateStr,timeStr,tz){if(!dateStr)return'Not Yet Aired';const zone=tz||DEFAULT_TZ,time=String(timeStr||'00:00'),m=time.match(/(\d{1,2}):(\d{2})/),hh=m?+m[1]:0,mm=m?+m[2]:0,d=new Date(dateStr);if(isNaN(d))return'Not Yet Aired';const y=+Utilities.formatDate(d,zone,'yyyy'),mo=+Utilities.formatDate(d,zone,'MM'),day=+Utilities.formatDate(d,zone,'dd'),rough=new Date(Date.UTC(y,mo-1,day,hh,mm)),z=Utilities.formatDate(rough,zone,'Z'),sg=z[0]==='-'?-1:1,off=sg*(+z.slice(1,3)*60 + +z.slice(3,5)),release=new Date(rough.getTime()-off*60000);return new Date()>=release?'Aired':'Not Yet Aired'}
function buildSiteData_(){const sm=Object.fromEntries(rows_('SETTINGS').map(r=>[r.Key,r.Value])),media=rows_('MEDIA').filter(r=>r.Status==='Active').map(r=>({id:r.Media_ID,category:r.Category,fileName:r.File_Name,driveFileId:r.Drive_File_ID,alt:r.Alt_Text,replaceable:truthy_(r.Replaceable)})),links=rows_('LINKS').map(r=>({id:r.Link_ID,label:r.Label,url:r.URL,location:r.Location,enabled:truthy_(r.Enabled),newTab:truthy_(r.New_Tab)})),ads=rows_('AD_SLOTS').map(r=>({id:r.Slot_ID,page:r.Page,placement:r.Placement,enabled:truthy_(r.Enabled),client:r.Ad_Client||'',slot:r.Ad_Slot||''})),artists=rows_('ARTISTS').filter(r=>r.Status==='Published').map(r=>({id:r.Artist_ID,slug:r.Slug,name:r.Name,fullName:r.Full_Name,role:r.Role,image:r.Image,bio:r.Bio,status:'published'})),series=rows_('SERIES').filter(r=>r.Publish_Status==='Published').map(r=>({id:r.Series_ID,slug:r.Slug,title:r.Title,year:String(r.Year||''),status:r.Series_Status,genres:r.Genres,image:r.Image,summary:r.Summary,timezone:r.Timezone||DEFAULT_TZ,relatedArtists:split_(r.Related_Artists)})),episodes=rows_('EPISODES').map(r=>({seriesId:r.Series_ID,episode:+(r.Episode_No||0),title:r.Title||'',releaseDate:dateOnly_(r.Release_Date),releaseTime:r.Release_Time||'',timezone:r.Timezone||DEFAULT_TZ,status:episodeStatus_(r.Release_Date,r.Release_Time,r.Timezone||DEFAULT_TZ),summary:r.Summary||''})),nb=rows_('NEWS_BLOCKS'),news=rows_('NEWS').filter(r=>r.Status==='Published').map(r=>({id:r.News_ID,slug:r.Slug,title:r.Title,showcaseTitle:r.Showcase_Title||r.Title,showcaseDescription:r.Showcase_Description||'',showcaseImage:r.Showcase_Image||'',category:r.Category||'',publishedDate:dateOnly_(r.Published_Date),relatedSeries:split_(r.Related_Series),relatedArtists:split_(r.Related_Artists),blocks:blocks_(nb,'News_ID',r.News_ID)})),eb=rows_('EVENT_BLOCKS'),events=rows_('EVENTS').filter(r=>r.Status==='Published').map(r=>({id:r.Event_ID,slug:r.Slug,title:r.Title,venue:r.Venue,date:dateOnly_(r.Date),time:r.Time||'',timezone:r.Timezone||DEFAULT_TZ,image:r.Image||'',relatedArtists:split_(r.Related_Artists),relatedSeries:split_(r.Related_Series),blocks:blocks_(eb,'Event_ID',r.Event_ID)})),vr=rows_('MERCH_VARIANTS'),merch=rows_('MERCH').filter(r=>r.Status==='Published').map(r=>({id:r.Merch_ID,slug:r.Slug,title:r.Title,description:r.Description||'',images:split_(r.Images),status:r.Availability||'',relatedArtists:split_(r.Related_Artists),relatedSeries:split_(r.Related_Series),variants:vr.filter(v=>String(v.Merch_ID)===String(r.Merch_ID)).map(v=>({name:v.Variation,price:+(v.Price||0),currency:v.Currency||'',status:v.Availability||''}))})),sitePages=rows_('SITE_PAGES').filter(r=>r.Status==='Published').map(r=>({slug:r.Slug,title:r.Title,heading:r.Heading,body:r.Body})),pageCopy=rows_('PAGE_COPY').filter(r=>r.Status==='Published').map(r=>({page:r.Page,eyebrow:r.Eyebrow,heading:r.Heading,description:r.Description})),homeSections=rows_('HOME_SECTIONS').filter(r=>r.Status==='Published').sort((a,b)=>+a.Sort-+b.Sort).map(r=>({id:r.Section_ID,sort:+r.Sort,type:r.Type,eyebrow:r.Eyebrow,title:r.Title,description:r.Description,primaryLabel:r.Primary_Label,primaryLink:r.Primary_Link,secondaryLabel:r.Secondary_Label,secondaryLink:r.Secondary_Link,relatedId:r.Related_ID})),notifications=rows_('NOTIFICATIONS').filter(r=>r.Status==='Published').map(r=>({id:r.Notification_ID,title:r.Title,message:r.Message,image:r.Image,link:r.Link,inSite:truthy_(r.In_Site),push:truthy_(r.Push),scheduleAt:r.Schedule_At}));return{settings:{siteName:sm.Site_Name||'Teshow × Ping PH',tagline:sm.Tagline||'',description:sm.Description||'',disclaimer:sm.Disclaimer||'',messageUrl:sm.Message_URL||'#',instagram:sm.Instagram_URL||'#',facebook:sm.Facebook_URL||'#',x:sm.X_URL||'#',adsEnabled:truthy_(sm.Ads_Global_Enabled||sm.Ads_Enabled),adsenseClient:sm.AdSense_Client||'',defaultTimezone:sm.Default_Timezone||DEFAULT_TZ},links,adSlots:ads,media,artists,series,episodes,news,events,merch,sitePages,pageCopy,homeSections,notifications}}
function clearPublicCache(){CacheService.getScriptCache().remove('site-data-v5')}
/* Run once after adding/replacing CMS media so Drive-hosted images can render publicly. */
function makeMediaPublic(){rows_('MEDIA').filter(r=>r.Status==='Active'&&r.Drive_File_ID).forEach(r=>{try{DriveApp.getFileById(r.Drive_File_ID).setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW)}catch(err){console.log(r.Media_ID+': '+err)}});clearPublicCache()}
